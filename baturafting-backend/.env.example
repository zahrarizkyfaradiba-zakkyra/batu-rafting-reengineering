PORT=5000

# Supabase: gunakan service_role key (JANGAN dipakai di frontend)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=isi_service_role_key_di_sini

# Login admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_kuat
# String acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=ganti_dengan_string_acak_panjang

# Production: daftar domain frontend yang diizinkan, pisahkan dengan koma. Kosong = semua boleh (dev saja)
CORS_ORIGINS=
